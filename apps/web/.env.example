# Copy to .env.local (gitignored) and fill in real values.
# GitHub OAuth App client ID with "Enable Device Flow" checked.
# https://github.com/settings/developers -> New OAuth App
VITE_GITHUB_CLIENT_ID=

# Spotify app client ID (PKCE, no secret needed). Not usable until the
# Spotify account has Premium -- see ROADMAP.md.
VITE_SPOTIFY_CLIENT_ID=

# Google Cloud OAuth client ID, "Desktop app" type (no secret needed --
# that's what makes the loopback flow secretless). Create at
# https://console.cloud.google.com/apis/credentials, and enable the
# Google Calendar API for the project. Desktop-only: needs Tauri's native
# loopback listener, doesn't work from a plain web build.
VITE_GOOGLE_CLIENT_ID=
