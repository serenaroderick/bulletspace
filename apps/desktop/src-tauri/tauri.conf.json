{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BulletSpace",
  "version": "0.1.0",
  "identifier": "space.bulletspace.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @bulletspace/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @bulletspace/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BulletSpace",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
